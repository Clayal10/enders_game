{
  	"name": "Ender's Game",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.27-bookworm",
  	"postCreateCommand": "/workspaces/enders_game/.devcontainer/postCreateCommand.sh",

	"features": {
	  "ghcr.io/devcontainers/features/docker-in-docker:4.1.2": {
	    "version": "latest",
	    "moby": true
	  }
	},
	"remoteUser": "vscode",
	"customizations": {
    	"vscode": {
    		"extensions": [
        		"golang.go"
      		],
    		"settings": {
        		"[go]": {
        			"editor.defaultFormatter": "golang.go",
        			"editor.formatOnSave": true,
        			"editor.codeActionsOnSave": {
            			"source.organizeImports": "explicit"
          			}
        		},
        		"gopls": {
          			"formatting.gofumpt": true
        		}
      		}
    	}
  	}
}
